# Local development values only. Change the password before exposing PostgreSQL
# beyond your local machine.
POSTGRES_DB=nexaops
POSTGRES_USER=nexaops
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Required for the protected document-management workflow. Set private local values.
NEXAOPS_ADMIN_USERNAME=
NEXAOPS_ADMIN_PASSWORD=
